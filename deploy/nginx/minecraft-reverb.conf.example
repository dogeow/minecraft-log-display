# Example snippets INSIDE the existing HTTPS server block for mc.dogeow.com.
# Review host, application path and existing routes before installation.
# Keep the current PHP/front-end locations and existing TLS certificate settings.

location ^~ /app/ {
    proxy_pass http://127.0.0.1:8080;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "Upgrade";
    proxy_read_timeout 90s;
    proxy_send_timeout 90s;
    proxy_buffering off;
}

# Laravel publishes directly over loopback. Do not expose the publishing API.
location ^~ /apps/ {
    return 404;
}
